    def Scope "_Materials"
    {
        def Material "Kapton"
        {
            token outputs:surface.connect = </ComputeSatelliteCustom/_Materials/Kapton/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.84, 0.56, 0.16)
                float inputs:metallic = 0.34
                float inputs:roughness = 0.19
                color3f inputs:specularColor = (1.0, 0.95, 0.72)
                float inputs:clearcoat = 0.56
                float inputs:clearcoatRoughness = 0.10
                token outputs:surface
            }
        }

