#usda 1.0
(
    defaultPrim = "RadiatorPanel"
    doc = "Illustrative test geometry for the SDTwin thermal scene tests; not a selected device. Invalid on purpose: the part carries a scale op, so its extent is not its physical size."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "RadiatorPanel"
{
    def Mesh "Panel"
    {
        float3[] extent = [(-0.2, -0.15, -0.001), (0.2, 0.15, 0.001)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        point3f[] points = [(-0.2, -0.15, -0.001), (0.2, -0.15, -0.001), (-0.2, 0.15, -0.001), (0.2, 0.15, -0.001), (-0.2, -0.15, 0.001), (0.2, -0.15, 0.001), (-0.2, 0.15, 0.001), (0.2, 0.15, 0.001)]
        uniform token subdivisionScheme = "none"
        double3 xformOp:scale = (2, 2, 1)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}

