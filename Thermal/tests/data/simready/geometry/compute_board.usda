#usda 1.0
(
    defaultPrim = "ComputeBoard"
    doc = "Illustrative test geometry for the SDTwin thermal scene tests; not a selected device. Authored in millimetres: board 160 x 100 x 1.6 mm, copper spreader 150 x 90 x 4 mm."
    metersPerUnit = 0.001
    upAxis = "Z"
)

def Xform "ComputeBoard"
{
    def Mesh "Board"
    {
        float3[] extent = [(-80, -50, -0.8), (80, 50, 0.8)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        point3f[] points = [(-80, -50, -0.8), (80, -50, -0.8), (-80, 50, -0.8), (80, 50, -0.8), (-80, -50, 0.8), (80, -50, 0.8), (-80, 50, 0.8), (80, 50, 0.8)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Spreader"
    {
        float3[] extent = [(-45, -75, -2), (45, 75, 2)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        point3f[] points = [(-45, -75, -2), (45, -75, -2), (-45, 75, -2), (45, 75, -2), (-45, -75, 2), (45, -75, 2), (-45, 75, 2), (45, 75, 2)]
        uniform token subdivisionScheme = "none"
        double xformOp:rotateZ = 90
        double3 xformOp:translate = (0, 0, 2.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }
}

