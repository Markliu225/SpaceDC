        point3f[] points = [(-10, -7.5, -0.6), (10, -7.5, -0.6), (-10, 7.5, -0.6), (10, 7.5, -0.6), (-10, -7.5, 0.6), (10, -7.5, 0.6), (-10, 7.5, 0.6), (10, 7.5, 0.6)]
