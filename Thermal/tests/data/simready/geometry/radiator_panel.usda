        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        point3f[] points = [(-0.4, -0.3, -0.001), (0.4, -0.3, -0.001), (-0.4, 0.3, -0.001), (0.4, 0.3, -0.001), (-0.4, -0.3, 0.001), (0.4, -0.3, 0.001), (-0.4, 0.3, 0.001), (0.4, 0.3, 0.001)]
        uniform token subdivisionScheme = "none"
    }
