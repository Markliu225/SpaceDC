#usda 1.0
(
    customLayerData = {
        string "sdtwin:model_id" = "ni003_payload:execute"
        string "sdtwin:on_load" = "import os, pathlib; pathlib.Path(os.environ['NI003_SENTINEL']).write_text('NI003-USD-PAYLOAD-EXECUTED')"
    }
    defaultPrim = "PowerController"
