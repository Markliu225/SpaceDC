#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Satellite close-up — lights + materials. The Satellite assembly is now the procedural twin body (usd/twin_satellite.usda) with VariantSets for the swappable GPU / SolarPanel / Radiator hardware. tools/apply_assembly.py is still available for the legacy LUMID monolith (usd/components.usda) but is no longer the primary visible body."
    subLayers = [
        @./twin_satellite.usda@
    ]
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Cameras/Closeup"
        }
    }
)

def Xform "World"
{
    def Xform "Environment"
    {
        # Direct sun — softer than before so PBR specular reads instead of
        # blowing out the diffuse channel.
        def DistantLight "Key"
        {
            float inputs:angle = 0.53
            float inputs:intensity = 3500
            color3f inputs:color = (1.0, 0.96, 0.88)
            # Azimuth 270° aims the sun at the solar wings' +X cell faces
            # (rz=40 lit them at -0.37, i.e. back-lit; rz=270 lights them at
            # +0.64). space.demo.scene now oscillates the azimuth about 270 so
            # the array stays sun-facing. Elevation -40 keeps the sun high.
            float3 xformOp:rotateXYZ = (-40, 0, 270)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        # Earth albedo — reflected earthshine from below.
        def DistantLight "EarthBounce"
        {
            float inputs:angle = 45.0
            float inputs:intensity = 1400
            color3f inputs:color = (0.34, 0.52, 0.82)
            float3 xformOp:rotateXYZ = (70, 0, 150)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        # Sharp rim from the opposite side — gives the solar panels a glassy
        # specular highlight against deep space.
        def DistantLight "Rim"
        {
            float inputs:angle = 1.5
            float inputs:intensity = 1300
            color3f inputs:color = (0.55, 0.7, 0.95)
            float3 xformOp:rotateXYZ = (15, 0, -120)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        # Deep space ambient — the always-on, all-direction fill (NOT in
        # SUN_DRIVEN_LIGHTS, so it holds through eclipse). This is the master
        # brightness knob: the old near-black colour (0.03) made it negligible,
        # leaving the ±Y radiators and the shadow side pitch black. Raised to a
        # real cool-grey ambient so the whole satellite reads clearly and the
        # glossy panels have a bright environment to reflect.
        def DomeLight "Space"
        {
            color3f inputs:color = (0.60, 0.66, 0.80)
            float inputs:intensity = 1500.0
            token inputs:texture:format = "latlong"
        }

        # --- Bay interior lights ---
        # Aimed at the DGX rack INSIDE the bay so you can see it through the
        # open front panel.  Invisible geometry; treatAsPoint keeps highlights sharp.
        # Bay cavity is ~40x30x36 cm centered on origin; DGX rack near world origin.
        def SphereLight "BayLightFront"
        {
            float inputs:radius = 0.3
            float inputs:intensity = 5000.0
            color3f inputs:color = (1.0, 0.97, 0.92)
            bool inputs:treatAsPoint = 1
            bool primvars:doNotCastShadows = 1
            token visibility = "invisible"
            double3 xformOp:translate = (0, -12, 8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def SphereLight "BayLightTop"
        {
            float inputs:radius = 0.3
            float inputs:intensity = 3500.0
            color3f inputs:color = (0.92, 0.96, 1.0)
            bool inputs:treatAsPoint = 1
            bool primvars:doNotCastShadows = 1
            token visibility = "invisible"
            double3 xformOp:translate = (0, 0, 14)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def SphereLight "BayLightSide"
        {
            float inputs:radius = 0.3
            float inputs:intensity = 2500.0
            color3f inputs:color = (0.85, 0.9, 1.0)
            bool inputs:treatAsPoint = 1
            bool primvars:doNotCastShadows = 1
            token visibility = "invisible"
            double3 xformOp:translate = (-12, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Scope "Looks"
    {
        # Main gold MLI blanket — used for panel main plates + solar panels.
        def Material "LumidShell"
        {
            token outputs:surface.connect = </World/Looks/LumidShell/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.62, 0.18)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        # Darker bronze seam stripe between MLI tiles.
        def Material "LumidShellSeam"
        {
            token outputs:surface.connect = </World/Looks/LumidShellSeam/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.38, 0.26, 0.08)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.65
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        # Brighter polished gold — used for corner rivets + edge flanges on solar panels.
        def Material "LumidShellRivet"
        {
            token outputs:surface.connect = </World/Looks/LumidShellRivet/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.76, 0.28)
                float inputs:metallic = 0.95
                float inputs:roughness = 0.15
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        # Deep blue solar-cell face.
        def Material "SolarCell"
        {
            token outputs:surface.connect = </World/Looks/SolarCell/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.10, 0.32)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.25
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        # Silver frame between solar cells.
        def Material "SolarCellFrame"
        {
            token outputs:surface.connect = </World/Looks/SolarCellFrame/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.70, 0.72, 0.78)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.35
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        # Mechanical hardware — copper tube / actuator housing.
        def Material "HardwareCopper"
        {
            token outputs:surface.connect = </World/Looks/HardwareCopper/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.36, 0.18)
                float inputs:metallic = 0.95
                float inputs:roughness = 0.28
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        # Mechanical hardware — matte black bracket plastic / carbon.
        def Material "HardwareBlack"
        {
            token outputs:surface.connect = </World/Looks/HardwareBlack/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.085, 0.09)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.75
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        # Mechanical hardware — brushed aluminum connector arm.
        def Material "HardwareAluminum"
        {
            token outputs:surface.connect = </World/Looks/HardwareAluminum/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.68)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.42
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
    }
}
