#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Satellite exterior — full colored LUMID model. Generated by tools/apply_assembly.py."
)

def Xform "World"
{
    def Xform "Satellite"
    {
        def Xform "LumidAssembly" (
            prepend references = @./assets/Satellite_v022.usdc@
        )
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            float3 xformOp:rotateXYZ = (0.0, 0.0, 0.0)
            double3 xformOp:scale = (1.0, 1.0, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }
    }

    def Xform "Cameras"
    {
        def Camera "Closeup"
        {
            float focalLength = 35.0
            float focusDistance = 300
            float2 clippingRange = (1, 4000)
            matrix4d xformOp:transform = (
                (0.74329, 0.66896, 0.00000, 0.00000),
                (-0.25314, 0.28127, 0.92564, 0.00000),
                (0.61922, -0.68802, 0.37841, 0.00000),
                (180.00000, -200.00000, 110.00000, 1.00000)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
