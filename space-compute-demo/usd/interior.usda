#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Inside the satellite -- corridor with NVIDIA Datacenter racks/servers/switches/CDU on both sides of a central aisle. Equipment refs come from the Datacenter_NVD asset pack; only the corridor shell + AIR WALL fan grid are procedural."
    customLayerData = { dictionary cameraSettings = { string boundCamera = "/World/Cameras/Aisle" } }
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "PanelWhite"
        {
            token outputs:surface.connect = </World/Looks/PanelWhite/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.93, 0.95)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
        def Material "FloorTile"
        {
            token outputs:surface.connect = </World/Looks/FloorTile/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.83, 0.86)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
        def Material "FanRing"
        {
            token outputs:surface.connect = </World/Looks/FanRing/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
        def Material "FanBlade"
        {
            token outputs:surface.connect = </World/Looks/FanBlade/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.2, 0.24)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "FanHub"
        {
            token outputs:surface.connect = </World/Looks/FanHub/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.47, 0.52)
                float inputs:metallic = 0.75
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
        def Material "Conduit"
        {
            token outputs:surface.connect = </World/Looks/Conduit/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.42, 0.85)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "EmitWhite"
        {
            token outputs:surface.connect = </World/Looks/EmitWhite/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 0.97, 0.94)
                color3f inputs:emissiveColor = (1.0, 0.97, 0.94)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Xform "Shell"
    {
        def Cube "Floor" ( prepend apiSchemas = ["MaterialBindingAPI"] )
        {
            double size = 1.0
            rel material:binding = </World/Looks/FloorTile>
            double3 xformOp:translate = (0, -145, -2)
            double3 xformOp:scale = (560, 580, 4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Ceiling" ( prepend apiSchemas = ["MaterialBindingAPI"] )
        {
            double size = 1.0
            rel material:binding = </World/Looks/PanelWhite>
            double3 xformOp:translate = (0, -145, 322)
            double3 xformOp:scale = (560, 580, 4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "WallLeft" ( prepend apiSchemas = ["MaterialBindingAPI"] )
        {
            double size = 1.0
            rel material:binding = </World/Looks/PanelWhite>
            double3 xformOp:translate = (-262, -145, 160)
            double3 xformOp:scale = (4, 580, 320)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "WallRight" ( prepend apiSchemas = ["MaterialBindingAPI"] )
        {
            double size = 1.0
            rel material:binding = </World/Looks/PanelWhite>
            double3 xformOp:translate = (262, -145, 160)
            double3 xformOp:scale = (4, 580, 320)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

