#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Twin satellite — Tripo compute-sat body (satellite_compute.usdz) with the missing solar panel mirrored in and the bus shell repainted gold. Generated by tools/gen_twin_satellite.py."
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Solar_Si"
        {
            token outputs:surface.connect = </World/Looks/Solar_Si/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.050, 0.150, 0.850)
                color3f inputs:emissiveColor = (0.100, 0.200, 0.850)
                float inputs:metallic = 0.300
                float inputs:roughness = 0.350
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "Solar_GaAs"
        {
            token outputs:surface.connect = </World/Looks/Solar_GaAs/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.450, 0.100, 0.550)
                color3f inputs:emissiveColor = (0.600, 0.100, 0.800)
                float inputs:metallic = 0.750
                float inputs:roughness = 0.200
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "Solar_Perovskite"
        {
            token outputs:surface.connect = </World/Looks/Solar_Perovskite/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.000, 0.350, 0.750)
                color3f inputs:emissiveColor = (1.400, 0.200, 0.900)
                float inputs:metallic = 0.500
                float inputs:roughness = 0.150
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "BusGold"
        {
            token outputs:surface.connect = </World/Looks/BusGold/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.800, 0.600, 0.200)
                color3f inputs:emissiveColor = (0.060, 0.040, 0.010)
                float inputs:metallic = 0.880
                float inputs:roughness = 0.320
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
    }

    def Xform "Satellite"
    {

    def Xform "Bus" (
        prepend references = @./assets/satellite_compute.usdz@
        variants = {
            string solar_material = "Si"
        }
        prepend variantSets = ["solar_material"]
    )
    {
        double3 xformOp:scale = (230.0, 230.0, 230.0)
        uniform token[] xformOpOrder = ["xformOp:scale"]

        over "ParentNode"
        {
            over "tripo_part_74_0"
            {
                over "Mesh_10"
                {
                    rel material:binding = </World/Looks/BusGold>
                }
            }
            over "tripo_part_new_1"
            {
                token visibility = "invisible"
            }
        }

        def Xform "PanelLeft" (
            prepend references = @./assets/solar.usdz@
        )
        {
            double3 xformOp:translate = (0.0, 0.45, 0.0)
            double3 xformOp:scale = (0.5, 0.5, 0.5)
            float xformOp:rotateZ = 180.0
            float xformOp:rotateY = -90.0
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale", "xformOp:rotateZ", "xformOp:rotateY"]
        }

        def Xform "PanelRight" (
            prepend references = @./assets/solar.usdz@
        )
        {
            double3 xformOp:translate = (0.0, -0.45, 0.0)
            double3 xformOp:scale = (0.5, 0.5, 0.5)
            float xformOp:rotateZ = 180.0
            float xformOp:rotateY = -90.0
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale", "xformOp:rotateZ", "xformOp:rotateY"]
        }

        variantSet "solar_material" = {
            "Si" { }
            "GaAs" { }
            "Perovskite" { }
        }
    }
    }

    def Xform "Cameras"
    {
        def Camera "Closeup"
        {
            float focalLength = 35.0
            float focusDistance = 430
            float2 clippingRange = (1, 5000)
            matrix4d xformOp:transform = (
                    (0.75569, 0.65493, -0.00000, 0.00000),
                    (-0.25781, 0.29748, 0.91926, 0.00000),
                    (0.60205, -0.69468, 0.39365, 0.00000),
                    (260.00000, -300.00000, 170.00000, 1.00000)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
