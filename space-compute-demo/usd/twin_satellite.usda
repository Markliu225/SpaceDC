#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Twin satellite — SpaceDcBackbone.usdz spine: a compute-server blade in each of the 12 rack slots, plus two oversized solar wings on booms off the central deployment brackets. Generated by tools/gen_twin_satellite.py."
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "ServerChassis"
        {
            token outputs:surface.connect = </World/Looks/ServerChassis/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.060, 0.065, 0.078)
                color3f inputs:emissiveColor = (0.010, 0.011, 0.014)
                float inputs:metallic = 0.550
                float inputs:roughness = 0.500
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "ServerHeatsink"
        {
            token outputs:surface.connect = </World/Looks/ServerHeatsink/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.560, 0.580, 0.610)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.800
                float inputs:roughness = 0.420
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "ServerFront"
        {
            token outputs:surface.connect = </World/Looks/ServerFront/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/ServerFront/Tex.outputs:rgb>
                color3f inputs:emissiveColor.connect = </World/Looks/ServerFront/Emit.outputs:rgb>
                float inputs:metallic = 0.0
                float inputs:roughness = 0.45
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/nv_blade_front.png@
                float2 inputs:st.connect = </World/Looks/ServerFront/St.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Emit"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/nv_blade_front_emit.png@
                float2 inputs:st.connect = </World/Looks/ServerFront/St.outputs:result>
                float4 inputs:scale = (1.40, 1.40, 1.40, 1.0)
                float3 outputs:rgb
            }
            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
        def Material "SolarFrame"
        {
            token outputs:surface.connect = </World/Looks/SolarFrame/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.620, 0.635, 0.660)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.950
                float inputs:roughness = 0.180
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
