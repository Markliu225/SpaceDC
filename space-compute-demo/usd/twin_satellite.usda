#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Twin satellite assembly — references the existing Satellite_v022 body and decorates it with reconfigurable solar wings + radiator panels + GPU rack. Generated by tools/gen_twin_satellite.py."
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Solar_Si"
        {
            token outputs:surface.connect = </World/Looks/Solar_Si/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.050, 0.150, 0.850)
                color3f inputs:emissiveColor = (0.100, 0.200, 0.850)
                float inputs:metallic = 0.300
                float inputs:roughness = 0.350
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "Solar_GaAs"
        {
            token outputs:surface.connect = </World/Looks/Solar_GaAs/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.450, 0.100, 0.550)
                color3f inputs:emissiveColor = (0.600, 0.100, 0.800)
                float inputs:metallic = 0.750
                float inputs:roughness = 0.200
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "Solar_Perovskite"
        {
            token outputs:surface.connect = </World/Looks/Solar_Perovskite/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.000, 0.350, 0.750)
                color3f inputs:emissiveColor = (1.400, 0.200, 0.900)
                float inputs:metallic = 0.500
                float inputs:roughness = 0.150
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "Rad_Aluminum"
        {
            token outputs:surface.connect = </World/Looks/Rad_Aluminum/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.750, 0.760, 0.780)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.950
                float inputs:roughness = 0.150
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "Rad_WhitePaint"
        {
            token outputs:surface.connect = </World/Looks/Rad_WhitePaint/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.940, 0.940, 0.940)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.050
                float inputs:roughness = 0.450
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "Rad_OSR"
        {
            token outputs:surface.connect = </World/Looks/Rad_OSR/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.820, 0.850, 0.900)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.700
                float inputs:roughness = 0.100
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "Rad_Graphite"
        {
            token outputs:surface.connect = </World/Looks/Rad_Graphite/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.070, 0.070, 0.080)
                color3f inputs:emissiveColor = (0.080, 0.020, 0.000)
                float inputs:metallic = 0.150
                float inputs:roughness = 0.550
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "GPU_H100"
        {
            token outputs:surface.connect = </World/Looks/GPU_H100/Shader.outputs:surface>
            def Shader "Shader"
            {
