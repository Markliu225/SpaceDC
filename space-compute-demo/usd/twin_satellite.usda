        }
        def Material "GPU_H200"
        {
            token outputs:surface.connect = </World/Looks/GPU_H200/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.230, 0.510, 0.990)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
