        }
        def Material "GPU_MI300X"
        {
            token outputs:surface.connect = </World/Looks/GPU_MI300X/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.860, 0.150, 0.150)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.600
                float inputs:roughness = 0.350
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
    }

    def Xform "Satellite"
    {

    def Xform "Bus" (
        prepend references = @./assets/Satellite_v022.usdc@
        variants = {
            string solar_material = "Si"
        }
        prepend variantSets = ["solar_material"]
    )
    {
        variantSet "solar_material" = {
        "Si" {
            over "Mesh"
            {
                over "Panel"
                {
                    rel material:binding = </World/Looks/Solar_Si>
                }
            }
        }
        "GaAs" {
            over "Mesh"
            {
                over "Panel"
                {
                    rel material:binding = </World/Looks/Solar_GaAs>
                }
            }
        }
        "Perovskite" {
            over "Mesh"
            {
                over "Panel"
                {
                    rel material:binding = </World/Looks/Solar_Perovskite>
                }
            }
        }
        }
    }

