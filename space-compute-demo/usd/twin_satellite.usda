#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Twin satellite — SpaceDcBackbone.usdz spine: a compute-server blade in each of the 12 rack slots, plus two oversized solar wings on booms off the central deployment brackets. Generated by tools/gen_twin_satellite.py."
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "ServerChassis"
        {
            token outputs:surface.connect = </World/Looks/ServerChassis/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.060, 0.065, 0.078)
                color3f inputs:emissiveColor = (0.010, 0.011, 0.014)
                float inputs:metallic = 0.550
                float inputs:roughness = 0.500
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "ServerBezel"
        {
            token outputs:surface.connect = </World/Looks/ServerBezel/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.020, 0.050, 0.060)
                color3f inputs:emissiveColor = (0.000, 0.850, 1.050)
                float inputs:metallic = 0.000
                float inputs:roughness = 0.300
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "ServerHeatsink"
        {
            token outputs:surface.connect = </World/Looks/ServerHeatsink/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.560, 0.580, 0.610)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.800
                float inputs:roughness = 0.420
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "SolarFrame"
        {
            token outputs:surface.connect = </World/Looks/SolarFrame/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.600, 0.630, 0.700)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.850
                float inputs:roughness = 0.350
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "RadiatorGlossy"
        {
            token outputs:surface.connect = </World/Looks/RadiatorGlossy/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.720, 0.745, 0.790)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.900
                float inputs:roughness = 0.060
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "EarthMat"
        {
            token outputs:surface.connect = </World/Looks/EarthMat/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/EarthMat/Day.outputs:rgb>
                color3f inputs:emissiveColor.connect = </World/Looks/EarthMat/Night.outputs:rgb>
                float inputs:metallic = 0.0
                float inputs:roughness = 0.85
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
            def Shader "Day"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/earth_day.jpg@
                float2 inputs:st.connect = </World/Looks/EarthMat/St.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Night"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/earth_night.jpg@
                float2 inputs:st.connect = </World/Looks/EarthMat/St.outputs:result>
                float4 inputs:scale = (0.95, 0.78, 0.45, 1.0)
                float3 outputs:rgb
            }
            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
        def Material "CloudMat"
        {
            token outputs:surface.connect = </World/Looks/CloudMat/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 1.0, 1.0)
                float inputs:opacity.connect = </World/Looks/CloudMat/Tex.outputs:r>
                float inputs:metallic = 0.0
                float inputs:roughness = 1.0
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/earth_clouds.jpg@
                float2 inputs:st.connect = </World/Looks/CloudMat/St.outputs:result>
                float outputs:r
            }
            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
        def Material "AtmosMat"
        {
            token outputs:surface.connect = </World/Looks/AtmosMat/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.350, 0.550, 1.000)
                color3f inputs:emissiveColor = (0.210, 0.330, 0.600)
                float inputs:opacity = 0.160
                float inputs:metallic = 0.0
                float inputs:roughness = 1.0
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "SunMat"
        {
            token outputs:surface.connect = </World/Looks/SunMat/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/SunMat/Tex.outputs:rgb>
                color3f inputs:emissiveColor.connect = </World/Looks/SunMat/Emit.outputs:rgb>
                float inputs:metallic = 0.0
                float inputs:roughness = 1.0
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/sun_surface.png@
                float2 inputs:st.connect = </World/Looks/SunMat/St.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Emit"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/sun_surface.png@
                float2 inputs:st.connect = </World/Looks/SunMat/St.outputs:result>
                float4 inputs:scale = (7.00, 5.20, 2.20, 1.0)
                float3 outputs:rgb
            }
            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

