#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Twin satellite — SpaceDcBackbone.usdz spine with a compute-server blade in each of the 12 rack slots. Generated by tools/gen_twin_satellite.py."
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "ServerChassis"
        {
            token outputs:surface.connect = </World/Looks/ServerChassis/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.060, 0.065, 0.078)
                color3f inputs:emissiveColor = (0.010, 0.011, 0.014)
                float inputs:metallic = 0.550
                float inputs:roughness = 0.500
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "ServerBezel"
        {
            token outputs:surface.connect = </World/Looks/ServerBezel/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.020, 0.050, 0.060)
                color3f inputs:emissiveColor = (0.000, 0.850, 1.050)
                float inputs:metallic = 0.000
                float inputs:roughness = 0.300
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "ServerHeatsink"
        {
            token outputs:surface.connect = </World/Looks/ServerHeatsink/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.560, 0.580, 0.610)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:metallic = 0.800
                float inputs:roughness = 0.420
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
    }

