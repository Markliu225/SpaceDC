#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 0.01
    doc = "Inside the satellite -- space-station-style data hall: 8 NVIDIA Rack_42U_A racks (4 per side), NVIDIA DCP_A coolant distribution unit at +Y end, procedural fan air-wall at -Y end, cable trays, ceiling strip lights. Cm units, origin at floor center."
    customLayerData = { dictionary cameraSettings = { string boundCamera = "/World/Cameras/Aisle" } }
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "FloorTile"
        {
            token outputs:surface.connect = </World/Looks/FloorTile/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.82)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "PanelWhite"
        {
            token outputs:surface.connect = </World/Looks/PanelWhite/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.87, 0.9)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
        def Material "Aluminum"
        {
            token outputs:surface.connect = </World/Looks/Aluminum/Shader.outputs:surface>
