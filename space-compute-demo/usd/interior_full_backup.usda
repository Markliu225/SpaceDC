            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.11, 0.13)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
        def Material "CableBlue"
        {
            token outputs:surface.connect = </World/Looks/CableBlue/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.3, 0.65)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
