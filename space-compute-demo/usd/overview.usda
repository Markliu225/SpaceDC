#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 100000
    doc = "Overview stage — baseline. Earth (sublayer earth_mesh.usda) + simple orbit line + one cyan satellite icon + Sun + dim sky + cinematic camera. Atmosphere shell / axial tilt / self-rotation / constellation all removed — Earth model to be redesigned from this clean baseline."
    subLayers = [
        @./earth_mesh.usda@,
        @./orbit_line.usda@
    ]
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Cameras/Overview"
        }
    }
)

def Xform "World"
{
    # --------------------------------------------------------------------
    # Lights — Earth lit by a single Sun + faint Sky ambient. Intentionally
    # minimal so the next iteration can rebuild the lighting from scratch.
    # --------------------------------------------------------------------
    def Xform "Environment"
    {
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            float inputs:intensity = 3500.0
            color3f inputs:color = (1.0, 0.97, 0.92)
            float3 xformOp:rotateXYZ = (-30, 0, 45)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        def DomeLight "Sky"
        {
            color3f inputs:color = (0.05, 0.07, 0.12)
            float inputs:intensity = 60.0
            token inputs:texture:format = "latlong"
        }
    }

    # Earth + orbit_line come from subLayers — no overrides here.

    # --------------------------------------------------------------------
    # Primary satellite icon — driven by space.demo.scene from the
    # backend's orbit formula. Single self-emissive sphere.
    # --------------------------------------------------------------------
    def Xform "SatelliteIcon" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double3 xformOp:translate = (69.21, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform bool primvars:doNotCastShadows = 1

        def Sphere "Glow"
        {
            double radius = 2.2
            rel material:binding = </World/SatelliteIcon/Glow/Mat>

            def Material "Mat"
            {
                token outputs:surface.connect = </World/SatelliteIcon/Glow/Mat/Shader.outputs:surface>
                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0, 0, 0)
                    color3f inputs:emissiveColor = (0.2, 2.5, 3.0)
                    float inputs:metallic = 0
                    float inputs:roughness = 1
                    int inputs:useSpecularWorkflow = 0
                    token outputs:surface
                }
            }
        }
    }

    # --------------------------------------------------------------------
    # Camera — look-at eye=(180,-180,120), target=(0,0,0), up=(0,0,1).
    # --------------------------------------------------------------------
    def Xform "Cameras"
    {
        def Camera "Overview"
        {
            float focalLength = 35
            float focusDistance = 283
            float2 clippingRange = (1, 5000)
            matrix4d xformOp:transform = (
                ( 0.7071,  0.7071,  0,      0),
                (-0.3015,  0.3015,  0.9044, 0),
                ( 0.6396, -0.6396,  0.4264, 0),
                ( 180,    -180,     120,    1)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
