#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 100000
    doc = "Overview stage — baseline. Earth (sublayer earth_mesh.usda) self-rotates around its +Z geographic axis once per 90 sim-seconds. The Sun stays fixed in world space at 23.5° elevation above the equatorial plane, so as the Earth spins the terminator stays tilted at the axial-tilt angle and different longitudes cycle through day/night."
    subLayers = [
        @./earth_mesh.usda@
    ]
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Cameras/Overview"
        }
    }
    startTimeCode = 0
    endTimeCode   = 90
    framesPerSecond = 30
    timeCodesPerSecond = 30
)

def Xform "World"
{
    # --------------------------------------------------------------------
    # Lights — single Sun + faint Sky ambient.
    #
    # Sun direction: we want the terminator on Earth (Z-up, geographic
    # north = +Z) to lean 23.5° relative to the north-south meridian, like
    # the planet at a solstice. That means the Sun's direction vector lies
    # in a plane tilted 23.5° from Earth's equatorial XY plane.
    #
    # Choose Sun position direction D_sun (from origin TOWARD the sun):
    #   azimuth = -45° in XY (camera-facing octant +X / -Y / +Z),
    #   elevation = +23.5° above the equatorial plane.
    # So D_sun = (cos23.5° cos(-45°),  cos23.5° sin(-45°),  sin23.5°)
    #          = (0.648,  -0.648,  0.398).
    # The DistantLight emits along -Z by default, then xformOpOrder rotates
    # that direction. We want it to land at -D_sun = (-0.648, 0.648, -0.398).
    # Apply rotateX(66.5°) -> (0, 0.917, -0.398), then rotateZ(45°) -> the
    # vector above. rotateXYZ = (66.5, 0, 45) reproduces that.
    # --------------------------------------------------------------------
    def Xform "Environment"
    {
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            float inputs:intensity = 3500.0
            color3f inputs:color = (1.0, 0.97, 0.92)
            float3 xformOp:rotateXYZ = (66.5, 0, 45)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        def DomeLight "Sky"
        {
            color3f inputs:color = (0.05, 0.07, 0.12)
            float inputs:intensity = 60.0
            token inputs:texture:format = "latlong"
        }
    }

    # --------------------------------------------------------------------
    # Earth — overlay on the prim defined in earth_mesh.usda. Animate
    # xformOp:rotateZ 0 → 360° over [0, 90] sim seconds so Kit's timeline
    # alone is enough to see the planet spin. space.demo.scene also writes
    # this attribute every frame against wall-clock sim time, which takes
    # precedence and gives smooth rotation even when the timeline is
    # stopped.
    # --------------------------------------------------------------------
    over "Earth"
    {
        float xformOp:rotateZ.timeSamples = {
            0: 0,
            90: 360,
        }
        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
    }

    # --------------------------------------------------------------------
    # Camera — eye=(180,-180,120), target=(0,0,0), up=(0,0,1).
    # --------------------------------------------------------------------
    def Xform "Cameras"
    {
        def Camera "Overview"
        {
            float focalLength = 35
            float focusDistance = 283
            float2 clippingRange = (1, 5000)
            matrix4d xformOp:transform = (
                ( 0.7071,  0.7071,  0,      0),
                (-0.3015,  0.3015,  0.9044, 0),
                ( 0.6396, -0.6396,  0.4264, 0),
                ( 180,    -180,     120,    1)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
