#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 100000
    doc = "Overview stage — Earth (sublayer earth_mesh.usda) self-rotates around its +Z geographic axis. Sun fixed in world space at 23.5° elevation above the equatorial plane → tilted terminator. /World/ConstellationGroup is fully authored at runtime by space.demo.scene based on the active constellation preset fetched from the backend."
    subLayers = [
        @./earth_mesh.usda@
    ]
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Cameras/Overview"
        }
    }
)

def Xform "World"
{
    # --------------------------------------------------------------------
    # Lights — single Sun + faint Sky ambient.
    # Sun rotateXYZ(66.5°, 0, 45°) puts D_sun = (0.648, -0.648, 0.398) →
    # azimuth -45° in XY, elevation +23.5° above equator → terminator
    # tilted 23.5° from the N-S meridian.
    # --------------------------------------------------------------------
    def Xform "Environment"
    {
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            float inputs:intensity = 3500.0
            color3f inputs:color = (1.0, 0.97, 0.92)
            float3 xformOp:rotateXYZ = (66.5, 0, 45)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        def DomeLight "Sky"
        {
            color3f inputs:color = (0.05, 0.07, 0.12)
            float inputs:intensity = 60.0
            token inputs:texture:format = "latlong"
        }
    }

    # --------------------------------------------------------------------
    # Earth — overlay on the prim defined in earth_mesh.usda. xformOp:rotateZ
    # is driven each frame by space.demo.scene (default value, no timeSamples).
    # --------------------------------------------------------------------
    over "Earth"
    {
        float xformOp:rotateZ = 0
        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
    }

    # --------------------------------------------------------------------
    # Cloud shell — semi-transparent sphere at Earth radius + ~14 km.
    # Material is OmniPBR.mdl with the NASA cloud map as both the diffuse
    # texture AND the opacity texture (grayscale, white = cloud, black =
    # clear sky). The shell rotates with the Earth (same rotateZ driver
    # so the clouds don't slide off — for the demo we treat them as
    # fixed-to-globe; weather drift is out of scope).
    # --------------------------------------------------------------------
    def Sphere "CloudShell" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 63.85
        float xformOp:rotateZ = 0
        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
        uniform bool primvars:doNotCastShadows = 1
        rel material:binding = </World/CloudShell/Mat>

        def Material "Mat"
        {
            token outputs:mdl:displacement.connect = </World/CloudShell/Mat/Shader.outputs:out>
            token outputs:mdl:surface.connect      = </World/CloudShell/Mat/Shader.outputs:out>
            token outputs:mdl:volume.connect       = </World/CloudShell/Mat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"

                # Diffuse — NASA cloud map; white pixels = cloud, black = clear.
                asset inputs:diffuse_texture = @./textures/earth_clouds.jpg@
                color3f inputs:diffuse_tint = (1.0, 1.0, 1.0)
                float inputs:reflection_roughness_constant = 0.9
                float inputs:metallic_constant = 0.0

                # Opacity — same map. Black -> transparent (Earth shows through),
                # white -> opaque cloud. opacity_mode = 1 selects alpha blend.
                bool inputs:enable_opacity = 1
                asset inputs:opacity_texture = @./textures/earth_clouds.jpg@
                float inputs:opacity_constant = 0.85
                int inputs:opacity_mode = 1

                token outputs:out
            }
        }
    }

    # --------------------------------------------------------------------
    # Constellation group — populated at runtime by space.demo.scene on
    # every constellation preset change:
    #   - Rings/Ring_K : one BasisCurves per orbital plane (P rings).
    #                    Each plane = base ring rotated about +Z by k·360°/P.
    #                    Non-emissive, thin gray-blue.
    #   - Fleet        : single UsdGeom.Points prim with T positions —
    #                    fast to update at 30 fps even for 1500+ sats.
    #                    Bright cyan emissive material.
    # Placeholder children below make the prims valid before the first
    # backend roundtrip lands; the extension overwrites them on first tick.
    # --------------------------------------------------------------------
    def Xform "ConstellationGroup"
    {
        def Xform "Rings" {}

        def Points "Fleet" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            point3f[] points = [(0, 0, 0)]
            float[] widths = [0.7] (
                interpolation = "constant"
            )
            float[] primvars:widths = [0.7] (
                interpolation = "constant"
            )
            uniform bool primvars:doNotCastShadows = 1
            rel material:binding = </World/ConstellationGroup/Fleet/Mat>

            def Material "Mat"
            {
                token outputs:surface.connect = </World/ConstellationGroup/Fleet/Mat/Shader.outputs:surface>
                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0, 0, 0)
                    color3f inputs:emissiveColor = (0.20, 1.80, 2.40)
                    float inputs:metallic = 0
                    float inputs:roughness = 1
                    int inputs:useSpecularWorkflow = 0
                    token outputs:surface
                }
            }
        }
    }

    # --------------------------------------------------------------------
    # Camera — eye=(180,-180,120), target=(0,0,0), up=(0,0,1).
    # --------------------------------------------------------------------
    def Xform "Cameras"
    {
        def Camera "Overview"
        {
            float focalLength = 35
            float focusDistance = 283
            float2 clippingRange = (1, 5000)
            matrix4d xformOp:transform = (
                ( 0.7071,  0.7071,  0,      0),
                (-0.3015,  0.3015,  0.9044, 0),
                ( 0.6396, -0.6396,  0.4264, 0),
                ( 180,    -180,     120,    1)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
