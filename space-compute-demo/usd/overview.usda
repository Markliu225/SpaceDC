#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 100000
    doc = "Overview stage. Architecture (per user direction): Earth tilted 23.5° around X (axial tilt), self-rotating around its tilted axis at 90 s/rev driven by space.demo.scene. Sun is a DistantLight in the equatorial plane (+X). Constellation orbits in Earth's equatorial frame so TLE inclinations are relative to Earth's equator, then is tilted together with the Earth."
    subLayers = [
        @./earth_mesh.usda@,
        @./constellation.usda@
    ]
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Cameras/Overview"
        }
        dictionary renderSettings = {
            int "rtx:post:tonemap:op" = 7
            float "rtx:post:tonemap:cameraShutter" = 0.08
        }
    }
    startTimeCode = 0
    endTimeCode   = 90
    framesPerSecond = 30
    timeCodesPerSecond = 30
)

def Xform "World"
{
    # --------------------------------------------------------------------
    # Lights — single natural sun in the equatorial plane (+X). No bounce
    # fill, no atmosphere shell, no decorative emissive. Sky DomeLight is
    # the only ambient contribution and it stays very low so the night
    # side of Earth reads as space-dark.
    # --------------------------------------------------------------------
    def Xform "Environment"
    {
        # Sun direction: light travels in -X (sun sits at +X). With
        # rotateY=90, DistantLight's default -Z direction is sent to -X.
        # Z stays 0 -> sun is in the equatorial plane -> terminator is a
        # clean meridian on the Earth.
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            float inputs:intensity = 120.0
            color3f inputs:color = (1.0, 0.97, 0.94)
            float3 xformOp:rotateXYZ = (0, 90, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        def DomeLight "Sky"
        {
            color3f inputs:color = (0.012, 0.018, 0.030)
            float inputs:intensity = 4.0
            token inputs:texture:format = "latlong"
        }
    }

    # --------------------------------------------------------------------
    # Earth — apply axial tilt + self-rotation as an `over` on the prim
    # defined by earth_mesh.usda. The xformOpOrder concatenates as
    # rotateX * rotateZ (rotateZ applied to local point first, then rotateX
    # tilts the spinning Earth), so the rotation axis ends up tilted in
    # world space at 23.5° from +Z.
    #
    # xformOp:rotateZ is animated: 0° at t=0, 360° at t=90 (one revolution
    # per 90 sim-seconds, matching the orbit period). space.demo.scene also
    # writes this each frame for live wall-clock motion.
    # --------------------------------------------------------------------
    over "Earth"
    {
        float xformOp:rotateX = 23.5
        float xformOp:rotateZ.timeSamples = {
            0: 0,
            90: 360,
        }
        uniform token[] xformOpOrder = ["xformOp:rotateX", "xformOp:rotateZ"]
    }

    # --------------------------------------------------------------------
    # Constellation — same 23.5° tilt as Earth so TLE inclinations stay
    # referenced to the Earth's (tilted) equator instead of the world
    # frame. Does NOT self-rotate (orbits are in the inertial frame).
    # --------------------------------------------------------------------
    over "Constellation"
    {
        float xformOp:rotateX = 23.5
        uniform token[] xformOpOrder = ["xformOp:rotateX"]
    }

    # --------------------------------------------------------------------
    # Primary satellite icon — driven by space.demo.scene from the
    # backend's orbit formula. Stays small and only modestly bright.
    # --------------------------------------------------------------------
    def Sphere "SatelliteIcon" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.45
        double3 xformOp:translate = (69.21, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform bool primvars:doNotCastShadows = 1
        rel material:binding = </World/SatelliteIcon/Mat>

        def Material "Mat"
        {
            token outputs:surface.connect = </World/SatelliteIcon/Mat/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0.05, 0.42, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 1
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
    }

    # --------------------------------------------------------------------
    # Cinematic camera — same framing as before.
    # --------------------------------------------------------------------
    def Xform "Cameras"
    {
        def Camera "Overview"
        {
            float focalLength = 28
            float focusDistance = 343
            float2 clippingRange = (1, 6000)
            matrix4d xformOp:transform = (
                ( 0.7071,  0.7071,  0,       0),
                (-0.3072,  0.3072,  0.9011,  0),
                ( 0.6371, -0.6371,  0.4343,  0),
                ( 220,    -220,     150,     1)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
