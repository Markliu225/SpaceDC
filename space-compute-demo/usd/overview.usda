#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 100000
    doc = "Overview stage: Blue-Marble Earth + 24 hairline orbit rings + 24 small sat dots + 1 moving primary satellite (driven by space.demo.scene). No atmosphere shell, no fat ribbons — just orbital dynamics."
    subLayers = [
        @./earth_mesh.usda@,
        @./constellation.usda@
    ]
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Cameras/Overview"
        }
        dictionary renderSettings = {
            int "rtx:post:tonemap:op" = 7
            # cameraShutter 1.0 was over-exposing the lit hemisphere of Earth to
            # pure white. 0.4 keeps the day side bright but textured.
            float "rtx:post:tonemap:cameraShutter" = 0.4
        }
    }
)

def Xform "World"
{
    # --------------------------------------------------------------------
    # Lights — key sun + soft fill + deep-space dome. No atmosphere fill.
    # --------------------------------------------------------------------
    def Xform "Environment"
    {
        # Sun toned down from 3000 -> 900. Previous value (with cameraShutter
        # 1.0) was producing a pure-white blowout on the lit hemisphere of
        # the Earth. 900 + shutter 0.4 gives roughly the same daylight feel
        # without saturating the diffuse texture.
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            float inputs:intensity = 900.0
            color3f inputs:color = (1.0, 0.97, 0.92)
            float3 xformOp:rotateXYZ = (-35, 0, 50)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        def DistantLight "Fill"
        {
            float inputs:angle = 14.0
            float inputs:intensity = 120.0
            color3f inputs:color = (0.45, 0.62, 0.95)
            float3 xformOp:rotateXYZ = (20, 0, -135)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        def DomeLight "Sky"
        {
            color3f inputs:color = (0.020, 0.026, 0.045)
            float inputs:intensity = 24.0
            token inputs:texture:format = "latlong"
        }
    }

    # Earth + 24 orbit rings + 24 sat dots come from sublayers.

    # --------------------------------------------------------------------
    # Primary satellite icon — driven by space.demo.scene every frame
    # along a 60° inclination ring (the actual backend simulation orbit).
    # Small bright cyan point so it reads as one moving light against
    # the constellation backdrop.
    # --------------------------------------------------------------------
    def Sphere "SatelliteIcon" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.5
        double3 xformOp:translate = (69.21, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform bool primvars:doNotCastShadows = 1
        rel material:binding = </World/SatelliteIcon/Mat>

        def Material "Mat"
        {
            token outputs:surface.connect = </World/SatelliteIcon/Mat/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0.18, 1.5, 1.7)
                float inputs:metallic = 0
                float inputs:roughness = 1
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
    }

    # --------------------------------------------------------------------
    # Cinematic camera — eye=(220,-220,150), target=(0,0,0), focal 28mm.
    # --------------------------------------------------------------------
    def Xform "Cameras"
    {
        def Camera "Overview"
        {
            float focalLength = 28
            float focusDistance = 343
            float2 clippingRange = (1, 6000)
            matrix4d xformOp:transform = (
                ( 0.7071,  0.7071,  0,       0),
                (-0.3072,  0.3072,  0.9011,  0),
                ( 0.6371, -0.6371,  0.4343,  0),
                ( 220,    -220,     150,     1)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
