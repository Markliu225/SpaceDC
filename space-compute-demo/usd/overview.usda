#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 100000
    doc = "Overview stage — Earth (sublayer earth_mesh.usda) rotates around its +Z geographic axis by the backend's broadcast GMST, and /World/Environment/Sun is re-aimed from the backend's broadcast sun_unit_teme, so the rendered day/night terminator is the physical one for the current sim instant rather than a fixed art direction. Both are written by space.demo.scene, which also authors /World/ConstellationGroup in full from the active preset's rings_eci_km (one ring per Walker plane / per SSO shell)."
    subLayers = [
        @./earth_mesh.usda@
    ]
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Cameras/Overview"
        }
    }
)

def Xform "World"
{
    # --------------------------------------------------------------------
    # Lights — single Sun + faint Sky ambient.
    #
    # The Sun's DIRECTION is authored at runtime by space.demo.scene
    # (set_overview_sun) from the backend's broadcast sun_unit_teme — the unit
    # Earth→Sun vector in the same TEME frame, at the same instant, as the
    # fleet ECI positions. A DistantLight emits along its local −Z, so the
    # rotateXYZ below is the one that aims local +Z at the sun.
    #
    # The value here is a NEUTRAL PLACEHOLDER only: (90, 0, 90) puts the sun on
    # the ECI +X axis (right ascension 0°, declination 0°). It is what renders
    # while the backend is offline, and it deliberately claims no season and no
    # tilt — the old hard-coded (66.5, 0, 45) / (0.648, -0.648, 0.398) was a
    # made-up sun 141° away from the real one, which is why nothing lined up
    # with the terminator.
    # --------------------------------------------------------------------
    def Xform "Environment"
    {
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            float inputs:intensity = 3500.0
            color3f inputs:color = (1.0, 0.97, 0.92)
            float3 xformOp:rotateXYZ = (90, 0, 90)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        def DomeLight "Sky"
        {
            color3f inputs:color = (0.05, 0.07, 0.12)
            float inputs:intensity = 60.0
            token inputs:texture:format = "latlong"
        }
    }

    # --------------------------------------------------------------------
    # Earth — overlay on the prim defined in earth_mesh.usda. xformOp:rotateZ
    # is driven each frame by space.demo.scene (default value, no timeSamples)
    # as GMST − 180°: earth_day.jpg is Greenwich-centred, so local +X shows
    # longitude −180 and that offset lands geographic longitude L at ECI right
    # ascension GMST + L. Ground markers are children of this prim, so they
    # inherit the spin and stay on their real sub-point.
    # --------------------------------------------------------------------
    over "Earth"
    {
        float xformOp:rotateZ = 0
        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
    }

    # --------------------------------------------------------------------
    # Constellation group — populated at runtime by space.demo.scene on
    # every constellation preset change:
    #   - Rings/Ring_K : one BasisCurves per ring in the backend's
    #                    rings_eci_km — one per Walker plane, one per SSO
    #                    shell. Kit does NOT rotate a single ring per plane
    #                    any more: SSO shells share one dawn–dusk RAAN and
    #                    differ only in altitude, and that rotation fanned
    #                    them into planes that do not exist.
    #                    Non-emissive, thin gray-blue.
    #   - Fleet        : single UsdGeom.Points prim with T positions —
    #                    fast to update at 30 fps even for 1500+ sats.
    #                    Bright cyan emissive material.
    # Placeholder children below make the prims valid before the first
    # backend roundtrip lands; the extension overwrites them on first tick.
    # --------------------------------------------------------------------
    def Xform "ConstellationGroup"
    {
        def Xform "Rings" {}

        def Points "Fleet" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            point3f[] points = [(0, 0, 0)]
            float[] widths = [0.7] (
                interpolation = "constant"
            )
            float[] primvars:widths = [0.7] (
                interpolation = "constant"
            )
            uniform bool primvars:doNotCastShadows = 1
            rel material:binding = </World/ConstellationGroup/Fleet/Mat>

            def Material "Mat"
            {
                token outputs:surface.connect = </World/ConstellationGroup/Fleet/Mat/Shader.outputs:surface>
                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0, 0, 0)
                    # Warm white — unambiguous against the 6-hue colored rings.
                    color3f inputs:emissiveColor = (2.60, 2.40, 1.90)
                    float inputs:metallic = 0
                    float inputs:roughness = 1
                    int inputs:useSpecularWorkflow = 0
                    token outputs:surface
                }
            }
        }
    }

    # --------------------------------------------------------------------
    # Camera — eye=(180,-180,120), target=(0,0,0), up=(0,0,1).
    # --------------------------------------------------------------------
    def Xform "Cameras"
    {
        def Camera "Overview"
        {
            float focalLength = 35
            float focusDistance = 283
            float2 clippingRange = (1, 5000)
            matrix4d xformOp:transform = (
                ( 0.7071,  0.7071,  0,      0),
                (-0.3015,  0.3015,  0.9044, 0),
                ( 0.6396, -0.6396,  0.4264, 0),
                ( 180,    -180,     120,    1)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
