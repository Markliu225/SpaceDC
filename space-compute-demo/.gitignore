# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo
.turbo/

# Env
.env
.env.local
.env.*.local

# IDE
.idea/
*.swp

# Omniverse
_build/
_compiler/
_repo/
.vscode-test/

# Assets (large binaries — keep in LFS or external store)
assets_raw/**/*.step
assets_raw/**/*.stp
assets_raw/**/*.iges
assets_raw/**/*.igs
assets_raw/**/*.sldprt
assets_raw/**/*.sldasm
assets_raw/**/*.fbx
assets_raw/**/*.glb
assets_usd/**/*.usdz
# Oversized USD payloads kept external (e.g. SpaceDcBackbone.usdz ~77MB) — the
# stages reference them by path; drop them next to the .usda locally.
usd/assets/*.usdz
assets_raw/**/*.usdz
!assets_raw/README.md
!assets_raw/MANIFEST.md

# Local tool outputs (regenerable by tools/render_usd.py + the inspect/analyze
# scripts) — never committed.
tools/_renders/
tools/*_report.json
tools/slots_report.json

# Heavy AEC City Tower demo pack (NVIDIA AECO, ~2.8 GB) — referenced by
# usd/mission.usda as the image-capture target scene, kept external to git.
usd/AECO_CityTowerDemoPack_NVD@*.zip
usd/aeco_city/

# Logs
*.log

# Runtime deployable-geometry overrides (Feature 3) — written by the backend.
usd/twin_params.json

# Design-gallery preview artifacts. The rendered PNGs are COMMITTED (so a
# fresh checkout never burns ~1 min of CPU re-rendering them at first boot);
# the scratch stages + params sidecars are regenerable and stay ignored.
usd/_preview_design_*.usda
usd/_preview_test.usda
usd/_design_previews/*.params.json
usd/_design_previews/_tmp_*
